{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/privacy",
      "destination": "/api/index?path=legal/privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/index?path=legal/terms"
    }
  ]
}
